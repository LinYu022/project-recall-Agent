# Optional shell settings for local storage and database (not read from .env).
# RECALL_ARTIFACT_DIR=.local/demo-runs
# RECALL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/recall
# Protected local workflow: set only in your shell; it is not read from .env.
# RECALL_CONTROL_TOKEN_OWNERS={"YOUR_RANDOM_LOCAL_USER_TOKEN":"Lin"}
# Integration tests use a separate disposable database, never production data:
# RECALL_TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/recall_test

# The generation adapter reads ONLY these five whitelisted keys from ignored .env.
# Shell values take precedence. Never commit a real key.
DEEPSEEK_BASE_URL=https://api.deepseek.com
RECALL_MODEL_ID=deepseek-flash
# DEEPSEEK_API_KEY=YOUR_LOCAL_KEY
# RECALL_MODEL_API_KEY=YOUR_LOCAL_KEY
# RECALL_MODEL_BASE_URL=https://api.deepseek.com
