# 填写仅含字母和数字的随机数据库密码。
RECALL_DB_PASSWORD=
# 填写 JSON 对象，例如 {"随机访问令牌":"user"}；在网页中输入同一令牌。
RECALL_CONTROL_TOKEN_OWNERS=

# 默认本地演示；改为 llm-demo 可使用合成示例资料调用真实 LLM。
RECALL_PRODUCT_PROFILE=synthetic-demo
# 仅在调用真实 LLM 时填写密钥。
RECALL_MODEL_API_KEY=
RECALL_MODEL_BASE_URL=https://api.deepseek.com
RECALL_MODEL_ID=deepseek-flash
