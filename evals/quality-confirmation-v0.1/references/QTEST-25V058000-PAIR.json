  "required_claims": [
    {
      "reference_claim_id": "R-25V058000-SUMMARY",
      "statement": "Toyota Motor Engineering & Manufacturing (Toyota) is recalling certain 2024-2025 Tacoma 4-wheel drive vehicles.  The rear brake hoses can be damaged if mud and dirt builds up inside the rear wheels.  This can result in a brake fluid leak.\nHuman-audited mandatory aspects (within relevant query scope): certain 2024-2025 Tacoma; 4-wheel drive restriction; mud/dirt inside rear wheels damages brake hoses; brake fluid leak",
      "evidence_sets": [
        [
          "25V058000-summary"
        ]
      ],
      "forbidden_inferences": [
        "individual_applicability",
        "causality",
        "incidence_rate",
        "all_vehicles_safe"
      ]
    },
    {
      "reference_claim_id": "R-25V058000-CONSEQUENCE",
      "statement": "A brake fluid leak can reduce braking ability and increase the risk of a crash.\nHuman-audited mandatory aspects (within relevant query scope): reduced braking increases crash risk",
      "evidence_sets": [
        [
          "25V058000-consequence"
        ]
      ],
      "forbidden_inferences": [
        "individual_applicability",
        "causality",
        "incidence_rate",
        "all_vehicles_safe"
      ]
    },
    {
      "reference_claim_id": "R-25V058000-REMEDY",
      "statement": "Dealers will replace both rear brake hoses, free of charge. Owner letters were mailed August 1, 2025. Owners may contact Toyota's customer service at 1-800-331-4331. Toyota's numbers for this recall are 25TB04 and 25TA04.\nHuman-audited mandatory aspects (within relevant query scope): replace both rear brake hoses free of charge",
      "evidence_sets": [
        [
          "25V058000-remedy"
        ]
      ],
      "forbidden_inferences": [
        "individual_applicability",
        "causality",
        "incidence_rate",
        "all_vehicles_safe"
      ]
    },
    {
      "reference_claim_id": "R-25V656000-SUMMARY",
      "statement": "Toyota Motor Engineering & Manufacturing (Toyota) is recalling certain 2025 Tacoma and Tacoma Hybrid vehicles. The front driveshaft constant-velocity (CV) joint may deform and break.\nHuman-audited mandatory aspects (within relevant query scope): certain 2025 Tacoma and Tacoma Hybrid; front driveshaft CV joint may deform and break",
      "evidence_sets": [
        [
          "25V656000-summary"
        ]
      ],
      "forbidden_inferences": [
        "individual_applicability",
        "causality",
        "incidence_rate",
        "all_vehicles_safe"
      ]
    },
    {
      "reference_claim_id": "R-25V656000-CONSEQUENCE",
      "statement": "A broken driveshaft can impair steering. Vehicles with full-time 4WD may experience a vehicle rollaway while parked without the parking brake applied. Both scenarios increase the risk of a crash.\nHuman-audited mandatory aspects (within relevant query scope): impaired steering; full-time 4WD rollaway when parked without parking brake; both increase crash risk",
      "evidence_sets": [
        [
          "25V656000-consequence"
        ]
      ],
      "forbidden_inferences": [
        "individual_applicability",
        "causality",
        "incidence_rate",
        "all_vehicles_safe"
      ]
    },
    {
      "reference_claim_id": "R-25V656000-REMEDY",
      "statement": "Dealers will inspect and replace both front driveshaft assemblies as necessary, free of charge. Owner letters were mailed August 11, 2026. Owners may contact Toyota's customer service at 1-800-331-4331. Toyota's numbers for this recall are 25TB11 and 25TA11.\nHuman-audited mandatory aspects (within relevant query scope): free inspection and replacement of both front driveshaft assemblies as necessary; preserve original August 11, 2026 mailing date if mentioned",
